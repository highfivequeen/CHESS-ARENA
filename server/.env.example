# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Path to a locally installed Stockfish UCI executable.
STOCKFISH_PATH=
# Search depth, from 1 to 20.
STOCKFISH_DEPTH=10

# Frontend HTTP/HTTPS origins allowed by the API and Socket.IO.
# Replace localhost with the exact public frontend origin(s) in production.
CLIENT_ORIGINS=http://localhost:5173

# Exact number of trusted reverse proxies in front of Express.
# Keep at zero if the API is directly exposed or the network path is unknown.
TRUST_PROXY_HOPS=0

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Product name (HIGHFIVE_CHESS). Optional: the defaults below already use it.
# Name of the authentication cookie (default: highfive_chess_session).
# AUTH_COOKIE_NAME=highfive_chess_session
# Sender of outgoing e-mails (default: "HIGHFIVE Chess <SMTP_USER>").
# EMAIL_FROM="HIGHFIVE Chess <no-reply@example.com>"
